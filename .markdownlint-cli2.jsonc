{
  // Full default ruleset, not just MD013. That was the deliberate original choice — turn a rule
  // on when it earns its place, not before — but adopting this kit into a project with its own
  // markdownlint config (MD036 and MD049 both surfaced this way) is what "earning its place"
  // looks like: the templates were tripping rules a downstream project runs by default, and this
  // repository's own linter, sitting at "default: false", could not have told us. Running the
  // full ruleset against ourselves is what an adopter's linter would already have done.
  //
  // MD013: matches the 100-column wrap AGENTS.md states as this repo's convention. Tables and
  // code blocks are exempt because neither can be wrapped without corrupting it; headings are
  // exempt because a heading is one line by construction — the only fix would be a rename, which
  // is not this tool's job.
  //
  // MD024: siblings_only, because a changelog repeating "### Added" under each version heading is
  // the format Keep a Changelog prescribes, not a duplication bug.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"]
}
